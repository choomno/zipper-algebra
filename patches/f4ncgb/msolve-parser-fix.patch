+
+// Inputs whose exact bytes matter (CRLF line endings) are written to a
+// temporary file here instead of living in parse_tests, where editors and git
+// may normalize line endings.
+static std::optional<std::string>
+parse_msolve_text(const std::string& name, const std::string& text) {
+  const auto path = std::filesystem::temp_directory_path() / name;
+  {
+    std::ofstream out(path, std::ios::binary);
+    out << text;
+  }
+  std::optional<std::string> err;
+  {
+    parser_context ctx;
+    internal::monomial_store<> ms;
+    internal::polynomial_store<> ps(ms);
+    err = invoke_parser(ctx, ps, path);
+  }
+  std::filesystem::remove(path);
+  return err;
+}
+
+BOOST_AUTO_TEST_CASE(parse_msolve_line_endings_and_variable_names) {
+  // A last line ending in "\r\n" must parse like the "\n" version.
+  const auto crlf = parse_msolve_text("f4ncgb_test_crlf.ms",
+                                      "x,y\r\n0\r\nx*y - y*x,\r\nx*x - 1\r\n");
+  BOOST_CHECK_MESSAGE(!crlf.has_value(), crlf.value_or(""));
+
+  // A multi-block header -- a comma ending the variable line opens a new block
+  // -- must behave the same way with CRLF.
+  const auto blocks = parse_msolve_text("f4ncgb_test_crlf_blocks.ms",
+                                        "x,y,\r\nz,w\r\n0\r\nx*z - z*x\r\n");
+  BOOST_CHECK_MESSAGE(!blocks.has_value(), blocks.value_or(""));
+
+  // A missing or undeclared variable name is reported as such.
+  const std::array<std::pair<std::string, std::string>, 6> bad = { {
+    { "x,\r\n0\r\nx*x\r\n", "Expected a digit" },
+    { "x,y\n0\nx*y - y*x,\nx*x - 1,\n", "Expected a variable name" },
+    { "x,y\n0\nx*y + -1*y*x\n", "Expected a variable name" },
+    { "x,y\n0\nx*-y\n", "Expected a variable name" },
+    { "x,y\n0\nx*y - y*x,\n\nx*x - 1\n", "Expected a variable name" },
+    { "x,y\n0\nx*z - 1\n", "Undeclared variable 'z'" },
+  } };
+  size_t i = 0;
+  for(const auto& [text, expected] : bad) {
+    const auto err = parse_msolve_text(
+      "f4ncgb_test_bad_" + std::to_string(i++) + ".ms", text);
+    BOOST_REQUIRE_MESSAGE(err.has_value(), "no error for input:\n" << text);
+    BOOST_CHECK_MESSAGE(err->find(expected) != std::string::npos,
+                        "expected '" << expected << "', got: " << *err);
+  }
+}
