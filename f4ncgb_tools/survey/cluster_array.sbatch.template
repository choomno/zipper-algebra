#!/bin/bash
#SBATCH --job-name=zipper-survey
#SBATCH --array=0-8                 # one task per spec; see `survey.py --list` for the range
#SBATCH --cpus-per-task=2
#SBATCH --mem=8G
#SBATCH --time=04:00:00
#SBATCH --output=logs/survey_%A_%a.out
#
# Mass survey job array: task ${SLURM_ARRAY_TASK_ID} runs one spec (resumable — a task whose
# result JSON already exists is skipped). Adjust --array to the spec count from `survey.py --list`.
# Edit the paths below for the cluster, then:  sbatch cluster_array.sbatch

set -euo pipefail
REPO=/path/to/zipper-algebra
export F4NCGB=/path/to/f4ncgb/build-release/f4ncgb
OUTDIR=$REPO/survey_results
SCRATCH=${TMPDIR:-/tmp}/zipper-survey-$SLURM_ARRAY_TASK_ID
mkdir -p "$SCRATCH" "$OUTDIR"

cd "$REPO"
# use the project venv with sympy if present
[ -x .venv-symrep/bin/python3 ] && PY=.venv-symrep/bin/python3 || PY=python3

"$PY" -m f4ncgb_tools.survey.survey --index "$SLURM_ARRAY_TASK_ID" \
      --outdir "$OUTDIR" --scratch "$SCRATCH"

# After all tasks finish, collate:  python3 -m f4ncgb_tools.survey.survey --aggregate --outdir survey_results
