// Exact noncommutative completion with compact local ideal-membership proofs.
// Called by four_strand_square_zero.py after declaring I and resource limits.
// Words use Singular's reversed variable order internally; exported indices
// are x1,x2,x3,y1,y2,y3. Every derivation references an input or an older node.
// S-pairs and inclusion ambiguities follow Bergman's Diamond Lemma (1978).
// No completeness assertion is accepted from the producer: replay the output
// with the independent checker, which checks every original relation as well.

ideal B;
list Words;
list Queues;
list Missing;
int nodeCount=0;
int pairCount=0;


int ng=6;
int ainit;
for(ainit=1;ainit<=maxDegree;ainit++){list qq;Queues[ainit]=qq;kill qq;}

proc wstr(poly p)
{
 intvec e=leadexp(p);int d=deg(lead(p));int a;int b;string s="";
 for(a=0;a<d;a++){for(b=1;b<=ng;b++){if(e[ng*a+b]!=0){s=s+string(b);}}}
 return(s);
}
proc wp(string s)
{
 poly p=1;int a;
 for(a=1;a<=size(s);a++){p=p*var(find("123456",s[a,1]));}
 return(p);
}
proc canon(string s)
{
 string out="";int a;
 for(a=1;a<=size(s);a++){out=out+string(7-find("123456",s[a,1]))+",";}
 return(out);
}
proc emitNode(int k,list terms)
{
 poly p=B[k];number c;int a;list z;
 while(p!=0){c=leadcoef(p);print("G|"+string(k)+"|"+string(c)+"|"+canon(wstr(p))+"|0|");p=p-lead(p);}
 for(a=1;a<=size(terms);a++)
 {
  z=terms[a];
  print("D|"+string(k)+"|"+string(z[1])+"|"+canon(z[2])+"|"+string(z[3])+"|"+string(z[4])+"|"+canon(z[5]));
 }
}
proc queuePair(int i,int j)
{
 string u=Words[i];string v=Words[j];int a;int n;int d;list rec;list bucket;
 if(size(v)<=size(u))
 {
  for(a=1;a<=size(u)-size(v)+1;a++)
  {
   if(u[a,size(v)]==v && (i!=j || a!=1))
   {
    d=size(u);rec=list(i,j,1,a);bucket=Queues[d];bucket[size(bucket)+1]=rec;Queues[d]=bucket;
   }
  }
 }
 n=size(u);if(size(v)<n){n=size(v);}
 for(a=1;a<n;a++)
 {
  if(u[size(u)-a+1,a]==v[1,a])
  {
   d=size(u)+size(v)-a;
   if(d<=maxDegree){rec=list(i,j,0,a);bucket=Queues[d];bucket[size(bucket)+1]=rec;Queues[d]=bucket;}
  }
 }
}
proc insertNode(poly p,list terms)
{
 if(p==0){return(0);}
 number inv=1/leadcoef(p);int a;list term;
 for(a=1;a<=size(terms);a++){term=terms[a];term[1]=inv*term[1];terms[a]=term;}
 nodeCount++;B[nodeCount]=inv*p;Words[nodeCount]=wstr(p);
 emitNode(nodeCount,terms);
 for(a=1;a<=size(Missing);a++){if(find(Missing[a],Words[nodeCount])>0){Missing=delete(Missing,a);a--;}}
 print("PROGRESS|"+string(nodeCount)+"|"+string(size(Missing))+"|"+string(pairCount));
 if(size(Words[nodeCount])==0){print("UNIT");return(nodeCount);}
 for(a=1;a<=nodeCount;a++){queuePair(nodeCount,a);if(a!=nodeCount){queuePair(a,nodeCount);}}
 return(nodeCount);
}
proc traceNF(poly p,list terms)
{
 poly rem=0;int i;int pos;int hit;string w;string u;string v;number c;
 while(p!=0)
 {
  w=wstr(p);hit=0;
  for(i=1;i<=nodeCount;i++)
  {
   pos=find(w,Words[i]);
   if(pos>0)
   {
    u="";v="";
    if(pos>1){u=w[1,pos-1];}
    if(pos+size(Words[i])<=size(w)){v=w[pos+size(Words[i]),size(w)-pos-size(Words[i])+1];}
    c=leadcoef(p);p=p-c*wp(u)*B[i]*wp(v);
    terms[size(terms)+1]=list(-c,u,1,i,v);hit=1;break;
   }
  }
  if(hit==0){rem=rem+lead(p);p=p-lead(p);}
 }
 return(list(rem,terms));
}

proc completeToHeads()
{
int k;
for(k=1;k<=size(I);k++)
{
 list terms=list(list(number(1),"",0,k,""));
 insertNode(I[k],terms);
 kill terms;
}
int d;int picked;int i;int j;int typ;int a;string u;string v;string left;string right;
poly S;poly screen;list rec;list bucket;list terms;list result;
while(size(Missing)>0 && nodeCount<maxNodes)
{
 picked=0;
 for(d=1;d<=maxDegree;d++)
 {
  bucket=Queues[d];
  if(size(bucket)>0)
  {
   rec=bucket[size(bucket)];bucket=delete(bucket,size(bucket));Queues[d]=bucket;picked=1;break;
  }
 }
 if(picked==0){break;}
 pairCount++;i=rec[1];j=rec[2];typ=rec[3];a=rec[4];u=Words[i];v=Words[j];left="";right="";
 if(typ==0)
 {
  if(size(u)>a){left=u[1,size(u)-a];}
  if(size(v)>a){right=v[a+1,size(v)-a];}
  S=B[i]*wp(right)-wp(left)*B[j];
  terms=list(list(number(1),"",1,i,right),list(number(-1),left,1,j,""));
 }
 else
 {
  if(a>1){left=u[1,a-1];}
  if(a+size(v)<=size(u)){right=u[a+size(v),size(u)-a-size(v)+1];}
  S=B[i]-wp(left)*B[j]*wp(right);
  terms=list(list(number(1),"",1,i,""),list(number(-1),left,1,j,right));
 }
 if(S!=0)
 {
  screen=reduce(S,B);
  if(screen!=0)
  {
   result=traceNF(S,terms);
   if(result[1]!=0){insertNode(result[1],result[2]);}
  }
 }
 if(pairCount % 1000==0){print("PAIRS|"+string(pairCount)+"|"+string(nodeCount)+"|"+string(size(Missing)));}
}
print("FINISH|"+string(nodeCount)+"|"+string(size(Missing))+"|"+string(pairCount));


}

proc emitDerived(poly p,list terms,int k)
{
 poly f=p;number c;int a;list z;
 while(f!=0){c=leadcoef(f);print("G|"+string(k)+"|"+string(c)+"|"+canon(wstr(f))+"|0|");f=f-lead(f);}
 for(a=1;a<=size(terms);a++)
 {
  z=terms[a];print("D|"+string(k)+"|"+string(-z[1])+"|"+canon(z[2])+"|1|"+string(z[4])+"|"+canon(z[5]));
 }
}
proc bridgeTargets()
{
int k;list terms;list result;
for(k=1;k<=size(Targets);k++)
{
 result=traceNF(Targets[k],terms);
 if(result[1]!=0){print("BRIDGE_FAILED|"+string(k));quit;}
 emitDerived(Targets[k],result[2],nodeCount+k);
}
print("BRIDGE_DONE|"+string(size(Targets)));

}
