include README.md LICENSE pyproject.toml setup.py .coveragerc
include INDEX.md WORKFLOW.md .gitignore .gitattributes
include .github/workflows/ci.yml
recursive-include src/zipper_algebra *.py
recursive-include src/zipper_algebra/zipping_algorithm/data *.json
include docs/ZIPPING_REFERENCE.md docs/ZIPPING_NATIVE.md docs/ZIPPING_NATIVE_VERIFIER.md
include docs/ZIPPING_GPU_PROTOTYPE.md docs/ZIPPING_GPU_REWRITE.md
include docs/TESTING.md docs/X3_REPRODUCTION.md docs/x3-reproduction-files.json
include docs/PROVENANCE.md
include docs/mathematical-specification/README.md docs/mathematical-specification/main.tex
include docs/mathematical-specification/mathematical-specification.pdf
recursive-include ci *.py
include patches/f4ncgb/README.md patches/f4ncgb/msolve-parser-fix.patch patches/f4ncgb/LICENSE
recursive-include tests *.py
recursive-include examples *.py
include examples/x3/README.md
include examples/x3/certificate.txt
recursive-include experiments *.py
include experiments/native/zipper_rewrite_cpu.cpp
recursive-include native/zipper_engine *.cpp *.hpp *.h
include native/zipper_engine/vendor/nlohmann/LICENSE.MIT
recursive-include native/zipper_verifier *.cpp *.hpp *.h
include native/zipper_verifier/vendor/nlohmann/LICENSE.MIT
recursive-include singular_run *.sing
include singular_run/README.md
include experiments/research/README.md experiments/variants/README.md
global-exclude *.py[cod]
global-exclude __pycache__
global-exclude AGENTS.md CLAUDE.md CONTRIBUTING.md CONTRIBUTING.MD
prune .cache
prune build
prune dist

exclude CONTRIBUTING.md CONTRIBUTING.MD
