include README.md LICENSE pyproject.toml .coveragerc
recursive-include src/zipper_algebra *.py
recursive-include docs *.md *.tex *.json
include docs/mathematical-specification/mathematical-specification.pdf
recursive-include ci *.py
recursive-include patches *.md *.patch LICENSE
recursive-include tests *.py *.json *.txt
recursive-include examples *.py *.md
recursive-include experiments *.py *.md
include data/aliases.json
include logs_and_traces/f4ncgb/cofactor-X3-n4-Qqt-symbolic.txt
include logs_and_traces/f4ncgb/basis-n4-Q.txt
include logs_and_traces/f4ncgb/basis-n4-Q-q3-t11.txt
include logs_and_traces/f4ncgb/basis-n4-Q-q7-t13.txt
global-exclude *.py[cod]
global-exclude __pycache__
prune .cache
prune build
prune dist

exclude CONTRIBUTING.md CONTRIBUTING.MD
