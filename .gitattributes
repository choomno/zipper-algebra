# Keep source and inventory hashes stable across checkout platforms.
* text=auto eol=lf

# Stored unified patches retain meaningful context whitespace.
*.patch -whitespace

# msolve/poly files are solver input data, not MAXScript programs.
*.ms -text -linguist-detectable linguist-language=Text
*.poly -text -linguist-detectable linguist-language=Text


# LaTeX manuscripts are mathematical documentation.
*.tex linguist-documentation
